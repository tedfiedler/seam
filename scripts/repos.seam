# repo health report — run: seam scripts/repos.seam
# pandas crunches the GitHub API; cowsay announces the winner.
use py "pandas" as pd
use py "builtins" as py

let user = "tedfiedler"
let df = pd.read_json("https://api.github.com/users/" + user + "/repos?per_page=100")
let mine = df[df["fork"] == false]

let pushed = pd.to_datetime(mine["pushed_at"])
let days = (pd.Timestamp.now(tz="UTC") - pushed).dt.days
let dates = pushed.dt.strftime("%Y-%m-%d")
let repos = mine.assign(days=days, date=dates).sort_values("days")
let view = repos[["name", "stargazers_count", "open_issues_count", "language", "date", "days"]].fillna("-")

let esc = py.chr(27)
fn color(code, s) { return esc + "[" + code + "m" + s + esc + "[0m" }
fn pad(s, w) { return py.format(str(s), "<" + w) }

print("")
print(color("1", user) + " — " + len(view) + " public repos, " + view["stargazers_count"].sum() + " stars")
print("")
print(color("2", pad("repo", 16) + pad("stars", 7) + pad("issues", 8) + pad("lang", 12) + pad("pushed", 12) + "status"))
for (r in view.to_dict("records")) {
  let status = color("31", "stale")
  if (r["days"] <= 7) { status = color("32", "active") }
  else if (r["days"] <= 60) { status = color("33", "quiet") }
  print(pad(r["name"], 16) + pad(r["stargazers_count"], 7) + pad(r["open_issues_count"], 8) + pad(r["language"], 12) + pad(r["date"], 12) + status)
}

# and because it's tradition by now
use js "cowsay" as cow
let top = view.sort_values("stargazers_count", ascending=false).iloc[0]
print("")
print(cow.say(text = top["name"] + " leads with " + top["stargazers_count"] + " stars"))
