# functions, recursion, loops, closures — run: seam examples/fib.seam
fn fib(n) {
  if (n < 2) { return n }
  return fib(n - 1) + fib(n - 2)
}

for (i in range(10)) {
  print("fib(" + i + ") =", fib(i))
}

# closures capture their environment mutably
fn make_counter() {
  let n = 0
  fn inc() {
    n = n + 1
    return n
  }
  return inc
}

let c = make_counter()
c()
c()
print("counter is at", c())  # 3

# fizzbuzz, obligatory
for (i in range(1, 16)) {
  if (i % 15 == 0) {
    print("fizzbuzz")
  } else if (i % 3 == 0) {
    print("fizz")
  } else if (i % 5 == 0) {
    print("buzz")
  } else {
    print(i)
  }
}
